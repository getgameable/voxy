{
  // The published declarations: src/index.ts and src/lib, into dist/types.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": false,
    "rootDir": "src",
    "outDir": "dist/types"
  },
  "include": ["src/index.ts", "src/lib", "src/ui"],
  "exclude": ["node_modules", "dist", "src/**/__tests__", "src/dev-ui"]
}
